# Environment variables for testing the Inventory Agent

# Anthropic API Key (required for agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database URL (for checkpointer - can use SQLite for testing)
DATABASE_URL=sqlite:///test_data/test_inventory.db

# Optional: Email configuration (if testing email tools)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password
SMTP_FROM_EMAIL=your_email@example.com

# Optional: API endpoints (if testing external APIs)
ORDER_API_ENDPOINT=https://api.example.com
ORDER_API_TOKEN=your_token
PRODUCT_API_ENDPOINT=https://api.example.com
PRODUCT_API_TOKEN=your_token
